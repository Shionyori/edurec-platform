temp/
# 平台本地数据（快照/推荐文件/演示数据），不提交
data/
backend/configs/config.local.yaml
backend/configs/config.demo.yaml
# 包管理器统一用 pnpm（pnpm-lock.yaml 已入库）；npm 误装产生的锁文件不入库
frontend/package-lock.json
# 本地 Go 构建缓存（GOCACHE 指向工作区时产生），不入库
.gocache/
# 一键启动/停止脚本运行时产生的 pid/日志
scripts/.run/
# Python 缓存（避免把 .pyc 带进仓库）
__pycache__/
*.py[cod]
# 临时分析脚本/中间结果
.tmp_*
# Impeccable 的机器本地状态与缓存（surfaces/ 下的是设计契约，需要入库）
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/questions/

# 本地 AI/技能工作流的临时状态（不属于产品代码）
.superpowers/
.claude/skills/*/scripts/__pycache__/
frontend/.impeccable/hook.cache.json
frontend/.impeccable/hook.pending.json
frontend/.impeccable/config.local.json
